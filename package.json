{
  "name": "lumencalc",
  "version": "0.1.1",
  "description": "LumenCalc: calculator, unit converter and code scratchpad. Web app wrapped for Android with Capacitor.",
  "scripts": {
    "test": "node test.js && node test-units.js && node test-files.js",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "dev": "live-server www --port=5173 --no-browser",
    "build:android": "cap sync android && cd android && gradlew assembleDebug",
    "vendor": "node scripts/vendor.js",
    "postinstall": "node scripts/vendor.js",
    "prebuild:android": "npm run vendor",
    "icons": "node scripts/icons.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.4",
    "mathjs": "^15.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "live-server": "^1.2.2",
    "sharp": "^0.35.5"
  }
}
